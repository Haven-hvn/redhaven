# WalletConnect / Reown project id (https://dashboard.reown.com). Required for the connect button.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Arkiv (index + text). Tiramisu testnet by default.
NEXT_PUBLIC_ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network

# Arkiv access key (raises the read quota; sent as X-API-KEY). Provided in CI from the
# ARKIV_API_KEY repo secret and inlined into the static bundle, so treat it as public.
NEXT_PUBLIC_ARKIV_API_KEY=

# Haven-AOL canister (epoch keys for sealed text/media). Mainnet canister by default.
NEXT_PUBLIC_ICP_HOST=https://icp-api.io
NEXT_PUBLIC_HAVEN_AOL_CANISTER_ID=gny6k-fqaaa-aaaab-ag3ra-cai
NEXT_PUBLIC_EIP712_CHAIN_ID=1
NEXT_PUBLIC_EIP712_VERIFYING_CONTRACT=0x0000000000000000000000000000000000000000
# Optional: pin the canister's Ed25519 attestation public key (64 hex). Every submission,
# comment and vote carries a membership receipt verified against it offline. Empty = query once.
NEXT_PUBLIC_HAVEN_ATTEST_PUBKEY=
NEXT_PUBLIC_HAVEN_AOL_FETCH_ROOT_KEY=false

# EVM RPCs for membership checks (balanceOf on the gate chain). Public nodes by default.
NEXT_PUBLIC_RPC_1=https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_RPC_8453=https://base-rpc.publicnode.com
NEXT_PUBLIC_RPC_10=https://optimism-rpc.publicnode.com
NEXT_PUBLIC_RPC_42161=https://arbitrum-one-rpc.publicnode.com
NEXT_PUBLIC_RPC_11155111=https://ethereum-sepolia-rpc.publicnode.com

# Filecoin via Synapse (media in submissions). Uploads pay USDFC from the connected wallet.
NEXT_PUBLIC_SYNAPSE_CHAIN_ID=8453
NEXT_PUBLIC_SYNAPSE_ENABLE_CDN=true

# Optional gateway for clear UnixFS roots written by other Haven apps (fcid).
# Leave empty to link out to haven-dapp instead (no gateway IP leak).
NEXT_PUBLIC_IPFS_GATEWAY=
NEXT_PUBLIC_HAVEN_DAPP_URL=https://haven.video

# Vote relay (off-chain, redhaven-only). Comma-separated Nostr relays for WebRTC signalling;
# empty = Trystero's defaults. Optional TURN for restrictive NATs: url|username|credential.
NEXT_PUBLIC_NOSTR_RELAYS=
NEXT_PUBLIC_TURN=

NEXT_PUBLIC_APP_URL=https://redhaven.local

# Optional CoinGecko demo key (free public tier) for the sidebar's asset description/image/market data.
# Keyless calls work at ~30/min per IP. Users can turn the lookup off in preferences.
NEXT_PUBLIC_COINGECKO_DEMO_KEY=
