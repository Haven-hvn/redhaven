{
  "name": "dsh-votes",
  "description": "redhaven voting for DeepSeek Harness agents: cast, change and retract HAVEN_VOTE_V3 votes on submissions and comments as an ordinary gate-token holder, proving membership with the same Haven-AOL receipt every redhaven user carries; hold a per-subreddit vote register in sync with browser peers over Trystero (Nostr signalling, WebRTC data via werift); rank listings with the web client's formulas. Composes dsh-wallet (+ wallet-ethereum provider:raw); optionally dsh-board.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runtime": {
      "types": "./lib/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "@redhaven/vote-core": "workspace:*",
    "trystero": "0.26.0",
    "werift": "0.25.2",
    "@icp-sdk/core": "6.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.5",
    "dsh-wallet": "=0.1.0",
    "dsh-board": "=0.1.0"
  },
  "peerDependenciesMeta": {
    "dsh-wallet": {
      "optional": false
    },
    "dsh-board": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.5",
    "tsdown": "0.23.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
