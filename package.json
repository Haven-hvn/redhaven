{
  "name": "redhaven-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "vendor": "node scripts/ensure-vendor.mjs",
    "web:dev": "pnpm --filter redhaven-web dev",
    "web:build": "pnpm --filter redhaven-web build"
  },
  "devDependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@types/node": "26.6.5",
    "tsdown": "0.23.2",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@reown/appkit"
    ]
  },
  "engines": {
    "node": "26.12.1"
  }
}
